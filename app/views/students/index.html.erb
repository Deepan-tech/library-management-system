
<!DOCTYPE html>
<html>
<head>
  <title>Students</title>

  <!-- Bootstrap CSS -->
  <%# <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"> %>
</head>

<body class="bg-light">
  <h1 class="text-primary text-center mb-4">
      Student List
    </h1>
  <div class="card p-3 mb-4 shadow-sm">
    <%= form_with url: students_path, method: :get, local: true do |form| %>

      <div class="row g-2">

        <div class="col-md-3">
          <%= form.select :search_by,
              [
                ["Student Name", "student_name"],
                ["Department", "department"]
              ],
              { selected: @search_by, prompt: "Select search type" },
              { class: "form-select" } %>
        </div>
         
        <div class="col-md-7">
          <%= form.text_field :query,
              value: @query,
              placeholder: "Enter student name or department",
              class: "form-control" %>
        </div>

        <div class="col-md-2">
          <%= form.submit "Search", class: "btn btn-primary w-100" %>
        </div>
      </div>

    <% end %>

    <div class="mt-2">
      <%= link_to "Clear Search", students_path,
          class: "btn btn-sm btn-outline-secondary" %>
    </div>
  </div>

  <div class="container mt-5">

    <% if @students.any? %>

      <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover bg-white">

          <thead class="table-dark">
             <tr>
              <%# <th>ID</th> %>
              <th>Username</th>
              <th>Email</th>
              <th>Mobile</th>
              <th>department</th>
            </tr>
          </thead>

          <tbody>
            <% @students.each do |student| %>
              <tr>
                <%# <td><%= student.id %></td>
                <td><%= student.username %></td>
                <td><%= student.email %></td>
                <td><%= student.mobile %></td>
                <td><%= student.department.department_name%></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    <% else %>

      <div class="alert alert-warning text-center">
        No students found.
      </div>

    <% end %>

  </div>
  <div class="btn position-fixed top-0 end-0 m-3">
      <%= button_to "Logout", logout_path,
      method: :delete,
      class: "btn btn-danger" %>
  </div>

  <div class="btn btn-primary position-fixed top-0 start-0 m-3">
  <%= link_to "Back to books", admin_dashboard_path %>
</div>

</body>
</html>
