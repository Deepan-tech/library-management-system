<% content_for :title, "Edit Book" %>

<div class="container mt-4">
  <div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
      <h4 class="mb-0">Edit Book</h4>
    </div>

    <div class="card-body">
      <%= render "form",
          book: @book,
          genres: @genres,
          authors: @authors %>
    </div>
  </div>

  <div class="mt-3">
    <%= link_to "Back to Books", books_path,
        class: "btn btn-secondary" %>
  </div>
</div>