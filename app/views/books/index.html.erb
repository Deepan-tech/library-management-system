
<!DOCTYPE html>
<html>
<head>
  <title>Books</title>
</head>
<body>

  <h1>Book List</h1>

<div class="mb-3">
  <label for="genre-filter">Filter by Genre</label>

  <select id="genre-filter" class="form-select">
    <option value="">All Genres</option>

    <% @genres.each do |genre| %>
      <option value="<%= genre.id %>">
        <%= genre.genre_name %>
      </option>
    <% end %>
  </select>
</div>

<table id="books-table" class="display table table-striped">
  <thead>
    <tr>
      <th>ID</th>
      <th>Title</th>
      <th>ISBN</th>
      <th>Edition</th>
    </tr>
  </thead>

  <tbody></tbody>
</table>

<%= link_to "Back to Genres", genre_index_path %>

</body>
</html>

<script>
 
document.addEventListener("DOMContentLoaded", function () {

  const table = new DataTable("#books-table", {

    processing: true,
    serverSide: true,

    ajax: {
      url: "/books.json",

      data: function (d) {
        d.genre_id = document.querySelector("#genre-filter").value;
      }
    },

    pageLength: 10,

    columns: [
      { data: "id" },

      {
        data: "title",

        render: function (data, type, row) {
          if (type !== "display") {
            return data;
          }

          const link = document.createElement("a");
          link.href = `/books/${row.id}`;
          link.textContent = data;

          return link;
        }
      },

      { data: "isbn" },
      { data: "edition" }
    ]

  });

  // Reload table when genre changes
  document.querySelector("#genre-filter")
    .addEventListener("change", function () {
      table.ajax.reload();
    });

});

</script>
