
<!DOCTYPE html>
<html>
<head>
  <title>Books</title>
</head>
<body>

  <h1>Book List</h1>

  <% if @books.any? %>

    <table border="1">
      <thead>
        <tr>
          <th>ID</th>
          <th>Title</th>
          <th>ISBN</th>
          <th>edition</th>
        </tr>
      </thead>

      <tbody>
        <% @books.each do |book| %>
          <tr>
            <td><%= book.id %></td>
            <td><a href="/books/<%= book.id %>"><%= book.title %></a></td>
            <td><%= book.isbn %></td>
            <td><%= book.edition %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p class="btn mt-3"><a href="/genre/index">Back to Genres</a></p>

  <% else %>
    <p>No books found.</p>
  <% end %>

</body>
</html>
