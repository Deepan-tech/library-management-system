
<!DOCTYPE html>
<html>
<head>
  <title>Books</title>
</head>
<body>

  <h1>Book List</h1>

  <% if @books.any? %>

    <table border="1" class="table table-striped table-bordered table-hover bg-white">
    <thead>
  <tr>
    <th>ID</th>
    <th>Title</th>
    <th>ISBN</th>
    <th>Author Name</th>
    <th>Edition</th>
    <th>Book Cover</th>

    <% if session[:admin_id].present? %>
      <th>Action</th>
    <% end %>
  </tr>
</thead>

     <tbody>
  <% @books.each do |book| %>
  <tr>
    <td><%= book.id %></td>

    <td>
      <%= link_to book.title, book_path(book) %>
    </td>

    <td><%= book.isbn %></td>

    <td><%= book.author.author_name %></td>

    <td><%= book.edition %></td>

    <td>
      <% if book.cover_image.attached? %>
        <%= image_tag book.cover_image,
            width: 80,
            height: 110,
            style: "object-fit: cover;" %>
      <% else %>
        No image
      <% end %>
    </td>

    <% if session[:admin_id].present? %>
      <td>
        <%= link_to "Edit", "/books/edit/#{book.id}" %>
      </td>
    <% end %>
  </tr>
<% end %>
</tbody>
    </table>

  <% else %>
    <p>No Books found.</p>
  <% end %>

</body>
</html>
