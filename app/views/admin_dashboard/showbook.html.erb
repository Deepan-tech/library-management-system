
<h1 class="mb-4">Book List</h1>

<% if @books.any? %>
  <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">

    <% @books.each do |book| %>
      <div class="col">
        <div class="card h-100 shadow-sm">

          
<% if book.cover_image.attached? %>
  <%= image_tag book.cover_image,
      class: "card-img-top",
      style: "height: 220px; object-fit: contain; padding: 10px;" %>

  <div class="text-center mb-2">
    <%= link_to "Download Image",
        rails_blob_path(book.cover_image, disposition: "attachment"),
        class: "btn btn-outline-success btn-sm" %>
  </div>
<% else %>
  <div class="bg-light d-flex align-items-center justify-content-center"
       style="height: 220px;">
    No Cover Image
  </div>
<% end %>


          <div class="card-body">
            <h5 class="card-title">
              <%= link_to book.title, book_path(book),
                  class: "text-decoration-none text-dark" %>
            </h5>

            <p class="card-text mb-1">
              <strong>Author:</strong> <%= book.author.author_name %>
            </p>

            <p class="card-text mb-1">
              <strong>ISBN:</strong> <%= book.isbn %>
            </p>

            <p class="card-text">
              <strong>Edition:</strong> <%= book.edition %>
            </p>
          </div>

          <% if session[:admin_id].present? %>
            <div class="card-footer bg-white">
              <%= link_to "Edit Book", "/books/edit/#{book.id}",
                  class: "btn btn-primary btn-sm w-100" %>
            </div>
          <% end %>

        </div>
      </div>
    <% end %>

  </div>
<% else %>
  <p>No Books found.</p>
<% end %>
