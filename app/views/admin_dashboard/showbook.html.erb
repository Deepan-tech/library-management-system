
<!DOCTYPE html>
<html>
<head>
  <title>Books</title>
</head>
<body>

  <h1>Book List</h1>

  <% if @books.any? %>

    <table border="1">
    <thead>
  <tr>
    <th>ID</th>
    <th>Title</th>
    <th>ISBN</th>
    <th>Edition</th>

    <% if session[:admin_id].present? %>
      <th>Action</th>
    <% end %>
  </tr>
</thead>

     <tbody>
  <% @books.each do |book| %>
    <tr>
      <td><%= book.id %></td>
      <td>
        <%= link_to book.title, book_path(book) %>
      </td>
      <td><%= book.isbn %></td>
      <td><%= book.edition %></td>

      <% if session[:admin_id].present? %>
        <td>
          <%= link_to "Edit", "/books/edit/#{book.id}" %>
        </td>
      <% end %>
    </tr>
  <% end %>
</tbody>
    </table>

  <% else %>
    <p>No Books found.</p>
  <% end %>

</body>
</html>
