
<h1 class="mb-4">Borrowing Status</h1>

<div class="card p-3 mb-4 shadow-sm">

  <%= form_with url: status_path, method: :get, local: true do |form| %>

    <div class="row g-2">

      <div class="col-md-3">
        <%= form.select :search_by,
          [
            ["Student Name", "student_name"],
            ["Department", "department"],
            ["Current Status", "status"],
            ["Genre Name", "genre"],
            ["Book Name", "book_name"]
          ],
          { selected: @search_by, prompt: "Select search type" },
          { class: "form-select" } %>
      </div>

      <div class="col-md-7">
        <%= form.text_field :query,
          value: @query,
          placeholder: "Enter search value",
          class: "form-control" %>
      </div>

      <div class="col-md-2">
        <%= form.submit "Search",
          class: "btn btn-primary w-100" %>
      </div>

    </div>

  <% end %>

  <div class="mt-2">
    <%= link_to "Clear Search", status_path,
      class: "btn btn-sm btn-outline-secondary" %>
  </div>

</div>

<table id ="status-table" class="table table-striped table-hover table-bordered bg-white">

  <thead class="table-dark">
    <tr>
      <th>Student Name</th>
      <th>Genre Name</th>
      <th>Book Name</th>
      <th>Copy Barcode</th>
      <th>Borrowed At</th>
      <th>Due At</th>
      <th>Return Status</th>
      <th>Action</th>
    </tr>
  </thead>

  <tbody>

    <% @statuses.each do |status| %>

      <tr>

        <td><%= status.student.username %></td>

        <td>
          <%= status.book_copy.book.genres.map(&:genre_name).join(", ") %>
        </td>

        <td><%= status.book_copy.book.title %></td>

        <td><%= status.book_copy.barcode %></td>

        <td><%= status.barrowed_at %></td>

        <td><%= status.due_at %></td>

        <td>
          <% if status.return_at.nil? %>
            Not Returned
          <% else %>
            Returned
          <% end %>
        </td>

        <td>
          <% if status.return_at.nil? %>

            <%= button_to "Mark as Returned",
              return_status_path(status),
              method: :patch,
              data: {
                turbo_confirm: "Confirm that this book has been returned?"
              },
              class: "btn btn-success btn-sm" %>

          <% else %>
            Already Returned
          <% end %>
        </td>

      </tr>

    <% end %>

  </tbody>

</table>

<% if @statuses.empty? %>
  <div class="alert alert-warning text-center">
    No borrowing records found.
  </div>
<% end %>

<div class="btn position-fixed top-0 end-0 m-3">
      <%= button_to "Logout", logout_path,
      method: :delete,
      class: "btn btn-danger" %>
  </div>


