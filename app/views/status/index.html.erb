<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Borrowing Status</h1>

  <% if session[:admin_id].present? %>
    <%= link_to "Export to Excel",
        export_status_path,
        class: "btn btn-success" %>
  <% end %>
</div>

<table id ="status-table" class="table table-striped table-hover table-bordered bg-white">

  <thead class="table-dark">
    <tr>
      <th>Student Name</th>
      <th>Genre Name</th>
      <th>Book Name</th>
      <th>Copy Barcode</th>
      <th>Borrowed At</th>
      <th>Due At</th>
      <th>Return Status</th>
      <th>Action</th>
    </tr>
  </thead>

  <tbody>

    <% @statuses.each do |status| %>

      <tr>

        <td><%= status.student.username %></td>

       <td>
         <%= status.book_copy.book.genre&.genre_name || "No genre assigned" %>
      </td>

        <td><%= status.book_copy.book.title %></td>

        <td><%= status.book_copy.barcode %></td>

        <td><%= status.barrowed_at %></td>

        <td><%= status.due_at %></td>

        <td>
          <% if status.return_at.nil? %>
            Not Returned
          <% else %>
            Returned
          <% end %>
        </td>

        <td>
          <% if status.return_at.nil? %>

            <%= button_to "Mark as Returned",
              return_status_path(status),
              method: :patch,
              data: {
                turbo_confirm: "Confirm that this book has been returned?"
              },
              class: "btn btn-success btn-sm" %>

          <% else %>
            Already Returned
          <% end %>
        </td>

      </tr>

    <% end %>

  </tbody>

</table>

<% if @statuses.empty? %>
  <div class="alert alert-warning text-center">
    No borrowing records found.
  </div>
<% end %>

<%# <div class="btn position-fixed top-0 end-0 m-3">
      <%= button_to "Logout", logout_path,
      method: :delete,
      class: "btn btn-danger" %>
  </div> %>


<script>
  
document.addEventListener("turbo:load", function () {

  const table = document.querySelector("#status-table");

  if (!table) return;

  // Check whether DataTables JavaScript is loaded
  if (typeof DataTable === "undefined") {
    console.error("DataTables library is not loaded!");
    return;
  }

  // Prevent duplicate initialization
  if (DataTable.isDataTable("#status-table")) {
    return;
  }

  new DataTable("#status-table", {
    pageLength: 5,

    lengthMenu: [5, 10, 25, 50, 100],

    ordering: true,

    searching: true,

    paging: true,

    info: true,

    columnDefs: [
      {
        targets: 7,
        orderable: false,
        searchable: false
      }
    ],

    language: {
      search: "Search:",
      lengthMenu: "Show _MENU_ entries",
      info: "Showing _START_ to _END_ of _TOTAL_ entries",
      emptyTable: "No borrowing records found",
      zeroRecords: "No matching records found"
    }
  });
});
</script>